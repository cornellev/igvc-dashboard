VITE_GOOGLE_MAPS_API_KEY=Your_Google_Maps_API_Key
VITE_GOOGLE_MAP_ID=Your_Google_Map_ID

# LAN IP of the Jetson on the router network.
JETSON_LAN_IP=192.168.1.2

# Optional override when the Fast DDS discovery server is not on JETSON_LAN_IP.
DISCOVERY_SERVER_IP=

# Optional override when the rosbag API is not on JETSON_LAN_IP.
ROSBAG_API_URL=
ROSBAG_API_HOST=
ROSBAG_API_PORT=8080
